@startuml B2_modele_domaine
title Modèle du domaine (concepts du monde universitaire)
skinparam dpi 150
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam class {
  BackgroundColor white
  BorderColor #1F3A5F
  ArrowColor #1F3A5F
}
hide circle
hide empty members

hide methods

class "Étudiant" as Etudiant {
  matricule
  nom
  disponibilité
}
class "Encadrant" as Encadrant {
  nom
  organisation
}
class "Programme" as Programme {
  nom
  plafond de crédits
  seuil de temps plein
}
class "Bloc de cours" as BlocDeCours {
  nom
  crédits min.
  crédits max.
}
class "Cours" as Cours {
  code
  titre
  crédits
}
class "Section" as Section {
  horaire
  places
}
class "Session" as Session {
  code
  dates limites
}
class "Relevé" as Releve {
  cours réussis
}
class "Plan de session" as PlanDeSession {
}
class "Demande" as Demande {
  type
  statut
  date d'envoi
}
class "Offre d'encadrement" as OffreDEncadrement {
  titre
  places
}
class "Avis" as Avis {
  note
  commentaire
}

Etudiant "*" -- "1" Programme : inscrit dans
Etudiant "1" -- "1" Releve : possède
Releve "*" -- "*" Cours : contient
Programme "1" -- "1..*" BlocDeCours : contient
BlocDeCours "*" -- "1..*" Cours : regroupe
Cours "*" -- "*" Cours : préalable de
Section "*" -- "1" Cours : offre
Section "*" -- "1" Session : pendant
Etudiant "1" -- "*" PlanDeSession : prépare
PlanDeSession "*" -- "*" Section : choisit
Etudiant "1" -- "*" Demande : envoie
Demande "*" -- "0..1" Section : concerne
Demande "*" -- "0..1" OffreDEncadrement : concerne
Encadrant "1" -- "*" OffreDEncadrement : publie
Etudiant "1" -- "*" Avis : écrit
Avis "*" -- "1" Cours : porte sur
@enduml
